      "name": "Public GET Endpoints",
      "item": [
        {
          "name": "GET /api/mcps — MCP Servers List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/mcps?pagination[pageSize]=24&pagination[page]=1",
            "description": "Fetch paginated MCP servers. Target: <500ms warm."
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
            "pm.test('Has Cache-Control', () => pm.response.to.have.header('Cache-Control'));",
            "pm.test('Content-Type is JSON', () => pm.response.to.have.header('Content-Type', /json/));",
            "pm.test('Body has data array', () => { const json = pm.response.json(); pm.expect(json.data).to.be.an('array'); });"
          ]}}]
        },
        {
          "name": "GET /api/tools — Tools List",
